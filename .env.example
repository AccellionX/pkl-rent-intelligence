# -----------------------------------------------------------------------------
# PKL Rent Intelligence — environment template
# Copy to `.env.local` for local development. Never commit real secrets.
# Without the public Supabase values, the app runs in explicit DEMO mode.
# -----------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for LIVE mode)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: future Phase 1 integrations (not used in Task #2)
# ANTHROPIC_API_KEY=
# GOOGLE_DRIVE_CLIENT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=
