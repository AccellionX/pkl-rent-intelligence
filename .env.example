# =============================================================================
# PKL Rent Intelligence — environment template
# Copy to `.env` (or `.env.local`) for local development. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — REQUIRED for live (customer) mode
# Browser-safe (NEXT_PUBLIC_*): URL + anon/publishable key only
# Server-only: service role key — never expose to the browser or NEXT_PUBLIC_
# Ownership: AccellionX / PKL project (not shared personal accounts)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — Supabase CLI / Management API (local machine only; never NEXT_PUBLIC_)
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# Optional — direct Postgres URI for migration apply scripts (local only)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Demo fixtures — OPTIONAL, development/tests only
# Never set on customer / production hosts
# -----------------------------------------------------------------------------
# PKL_ALLOW_DEMO_MODE=true

# -----------------------------------------------------------------------------
# Anthropic Claude — OPTIONAL (narrative drafts); server-only
# Ownership: PKL / AccellionX org API key (not a personal key in production)
# Without this key the app uses a deterministic fallback draft
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your_key
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# -----------------------------------------------------------------------------
# Google Geocoding — OPTIONAL (MLS distances); server-only
# Ownership: GCP project billed to PKL / AccellionX
# Without billing/key, distance fields stay unavailable (no fabricated miles)
# -----------------------------------------------------------------------------
# GOOGLE_GEOCODING_API_KEY=your_geocoding_key
# GOOGLE_MAPS_API_KEY=            # accepted as alias of GOOGLE_GEOCODING_API_KEY

# -----------------------------------------------------------------------------
# Google Drive backup — OPTIONAL (finalized PDF backup); server-only
# Prefer OAuth refresh token for a dedicated PKL Google account that owns the
# reports root folder. Never put these in NEXT_PUBLIC_* or client bundles.
# Setup helper: node scripts/google-drive-oauth-setup.mjs
# -----------------------------------------------------------------------------
# GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token
# GOOGLE_DRIVE_ROOT_FOLDER_ID=optional_fallback_root_folder_id
# GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

# -----------------------------------------------------------------------------
# PDF renderer — OPTIONAL
# Default / omit = jspdf (serverless-safe). playwright = local/worker with Chromium
# -----------------------------------------------------------------------------
# PDF_RENDERER=jspdf

# -----------------------------------------------------------------------------
# Local engineering / Playwright scripts — OPTIONAL, never commit values
# -----------------------------------------------------------------------------
# PKL_E2E_EMAIL=staff@example.com
# PKL_E2E_PASSWORD=replace_me
# PKL_E2E_TENANT_B_EMAIL=qa.tenant.b@example.com
# PKL_E2E_TENANT_B_PASSWORD=replace_me
# PKL_CLIENT_SOURCE_DIR=/absolute/path/to/local/client/source/packages
# PKL_TASK05_USER_JSON=/absolute/path/to/local/test-user.json
